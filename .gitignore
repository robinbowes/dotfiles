\#*\#
tags


.claude

# Zsh runtime caches and per-host overrides (live in $ZDOTDIR)
.config/zsh/.zcompdump*
.config/zsh/.zsh_plugins.zsh
.config/zsh/.zsh_history
.config/zsh/.antidote/
.config/zsh/path.local

# direnv files - these often contain secrets
.envrc

**/.claude/settings.local.json

# Worktrees checked out inside the repo they belong to. Each one is a working
# tree with its own .git file, so the parent repo sees an embedded repository
# and `git add -A` stages it as a gitlink (mode 160000) rather than skipping it.
# The result is a commit that looks like a one-line addition and is not.
# (Git's own .git/worktrees/ metadata needs no rule — it is inside .git.)
.git-worktrees/

# Local PR-review output from the lastlight-pr-gate plugin (findings, diff,
# reviewer log, attestation). Machine-specific and regenerable, like .envrc.
# NARROW deliberately: a committed `.lastlight/lastlight.yml` (plus workflows/,
# skills/, agent-context/) is Last Light's supported PER-REPO CONFIG OVERLAY,
# read from the default branch. Ignoring `.lastlight/` wholesale would silently
# block ever committing one.
.lastlight/pr-review/
