Include config.d/*.config

# global configuration
Host *
  ControlMaster auto
  ControlPath ~/tmp/.ssh/cm/%C.sock
  ControlPersist 10m
  # ForwardAgent deliberately omitted here (defaults to 'no').
  # Enable per-host in config.d/ instead - blocks there are read first and win.
  #IdentityFile ~/.ssh/id_rsa
  #IdentityFile ~/.ssh/id_rsa_robin
  #IdentityFile ~/.ssh/id_rsa_ca
  #IdentityFile ~/.ssh/id_ed25519
  LogLevel ERROR
  Port 22
